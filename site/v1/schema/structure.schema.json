{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structure",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "icon",
    "cost",
    "upgradesFrom",
    "size",
    "namePlain",
    "descriptionPlain",
    "upgradesTo",
    "thumb"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "en"
      ]
    },
    "description": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "icon": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$"
    },
    "cost": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "quantity"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "upgradesFrom": {
      "type": [
        "string",
        "null"
      ]
    },
    "size": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "namePlain": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "name without the game's text markup"
    },
    "descriptionPlain": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "description without the game's text markup"
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "description": "the game's structure category (FOOD, FAITH, ...), null if not buildable"
    },
    "buildable": {
      "type": "boolean",
      "description": "appears in the build menu"
    },
    "menu": {
      "type": [
        "string",
        "null"
      ],
      "description": "build menu tab and section, e.g. Follower/Food, Faith/Sin, Aesthetic/Path; null if not in the build menu"
    },
    "upgradesTo": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "structures that upgrade from this one (the reverse of upgradesFrom)"
    },
    "thumb": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^icons/structures/64/[A-Za-z0-9_-]+\\.png$",
      "description": "the icon fitted into 64x64 (null if no icon)"
    }
  }
}
