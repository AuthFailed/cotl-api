{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "icon",
    "category",
    "namePlain",
    "descriptionPlain"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "en"
      ]
    },
    "description": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "icon": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$"
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "namePlain": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "name without the game's text markup"
    },
    "descriptionPlain": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "description without the game's text markup"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "food, fish, big_fish, meat, heart, gift, meal, drink"
    },
    "meal": {
      "description": "Meals and drinks only (null otherwise): how to make it and what it does",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "recipes",
        "satiation",
        "satiationPlayer",
        "stars",
        "tummyRating",
        "faith",
        "cookTime",
        "dlc",
        "effects"
      ],
      "properties": {
        "recipes": {
          "type": "array",
          "description": "every ingredient combination the game accepts; empty for what the kitchen doesn't cook (a burned meal comes from overcooking)",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item",
                "quantity"
              ],
              "properties": {
                "item": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "satiation": {
          "type": "integer",
          "description": "how much a follower's hunger it fills (the game's own units)"
        },
        "satiationPlayer": {
          "type": "integer",
          "description": "how much it heals the player when eaten"
        },
        "stars": {
          "type": "integer",
          "description": "quality stars the cooking menu shows"
        },
        "tummyRating": {
          "type": "number"
        },
        "faith": {
          "type": "integer",
          "description": "faith gained when followers eat it"
        },
        "cookTime": {
          "type": "number",
          "description": "cooking time (the game's own units)"
        },
        "dlc": {
          "type": "boolean"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "chance",
              "description",
              "descriptionPlain"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "chance": {
                "type": "integer",
                "description": "percent"
              },
              "description": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "required": [
                  "en"
                ]
              },
              "descriptionPlain": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
