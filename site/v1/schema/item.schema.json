{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "icon",
    "category"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "en"
      ]
    },
    "description": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "icon": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$"
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
