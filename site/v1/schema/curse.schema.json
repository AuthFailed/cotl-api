{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curse",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "namePlain",
    "descriptionPlain",
    "icon",
    "thumb",
    "lore",
    "family",
    "damage",
    "delay",
    "castingDuration",
    "chance",
    "canAim"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "en"
      ]
    },
    "description": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "namePlain": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "name without the game's text markup"
    },
    "descriptionPlain": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "description without the game's text markup"
    },
    "icon": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^icons/curses/[A-Za-z0-9_-]+\\.png$"
    },
    "thumb": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^icons/curses/64/[A-Za-z0-9_-]+\\.png$"
    },
    "lore": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "family": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tentacles, EnemyBlast, ProjectileAOE, Fireball, MegaSlash, Teleport, Barrier"
    },
    "damage": {
      "type": "number",
      "description": ""
    },
    "delay": {
      "type": "number",
      "description": ""
    },
    "castingDuration": {
      "type": "number",
      "description": ""
    },
    "chance": {
      "type": "number",
      "description": ""
    },
    "canAim": {
      "type": "boolean",
      "description": ""
    }
  }
}
