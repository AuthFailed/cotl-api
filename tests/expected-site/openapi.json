  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "What this data is",
      "name": "index"
    },
    {
      "description": "Resources, food, seeds, necklaces and everything else in the inventory",
      "name": "items"
    },
    {
      "description": "Buildings, decorations and tiles: cost, upgrade chain, footprint",
