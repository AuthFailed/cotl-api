            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "enum": [
                "LOG",
                "STONE"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "OK"
          },
          "404": {
            "description": "No such id"
          }
        },
        "summary": "A item's icon",
        "tags": [
          "items"
        ]
      }
    },
