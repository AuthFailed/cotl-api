  "externalDocs": {
    "description": "README",
    "url": "https://github.com/AuthFailed/cotl-api#readme"
  },
  "info": {
    "description": "Items, structures and follower skins from *Cult of the Lamb*, taken from the game (version 1.4.6, captured 2026-10-29T12:00:00Z). Static JSON: no keys, no rate limits, open CORS. Within `v1/` fields are only added, never removed.\n\nWhat changed with each game version: [changes.json](/v1/changes.json). Field-by-field documentation and examples: the [README](https://github.com/AuthFailed/cotl-api#readme).\n\nUnofficial fan project; the game, its data and art belong to Massive Monster and Devolver Digital. Source: [github.com/AuthFailed/cotl-api](https://github.com/AuthFailed/cotl-api).",
    "title": "Cult of the Lamb data API",
    "version": "1.4.6"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/changes.json": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": [],
                "schema": {
                  "$ref": "#/components/schemas/Changes"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "description": "No such id"
          }
        },
        "summary": "What each game version added, removed or changed, newest first",
        "tags": [
          "index"
        ]
      }
    },
    "/v1/icons/items/{id}.png": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "enum": [
                "LOG",
                "STONE"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "OK"
          },
          "404": {
            "description": "No such id"
          }
        },
        "summary": "A item's icon",
        "tags": [
          "items"
        ]
      }
    },
    "/v1/icons/rituals/{id}.png": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "enum": [
                "Ritual_Feast"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "OK"
          },
          "404": {
            "description": "No such id"
          }
        },
        "summary": "A ritual's icon",
        "tags": [
          "rituals"
        ]
      }
    },
    "/v1/icons/structures/{id}.png": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "enum": [
                "FARM_PLOT",
                "SHRINE_II"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "OK"
          },
          "404": {
            "description": "No such id"
          }
        },
        "summary": "A structure's icon",
        "tags": [
          "structures"
        ]
      }
    },
    "/v1/index.json": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "capturedAt": "2026-10-29T12:00:00Z",
