            "name": "id",
            "required": true,
            "schema": {
              "enum": [
                "FARM_PLOT",
                "SHRINE_II"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Structure"
