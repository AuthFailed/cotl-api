                }
              }
            },
            "description": "OK"
          },
          "404": {
            "description": "No such id"
          }
        },
        "summary": "Game version, capture date, languages and counts",
        "tags": [
          "index"
        ]
      }
    },
    "/v1/items.json": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "description": "No such id"
          }
        },
        "summary": "Every item",
        "tags": [
          "items"
        ]
      }
    },
    "/v1/items/{id}.json": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "enum": [
                "BERRY",
                "LOG",
                "MEAL_BERRIES",
                "SEED",
                "STONE"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            },
            "description": "OK"
          },
          "404": {
