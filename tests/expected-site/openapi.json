{
  "components": {
    "schemas": {
      "Changes": {
        "description": "Newest first: what each new game version added, removed or changed.",
        "items": {
          "properties": {
            "added": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": [
                "items",
                "structures",
                "skins"
              ],
              "type": "object"
            },
            "capturedAt": {
              "type": "string"
            },
            "changed": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": [
                "items",
                "structures",
                "skins"
              ],
              "type": "object"
            },
            "gameVersion": {
              "type": "string"
            },
            "removed": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": [
                "items",
                "structures",
                "skins"
              ],
              "type": "object"
            }
          },
          "required": [
            "gameVersion",
            "capturedAt",
            "added",
            "removed",
            "changed"
          ],
          "type": "object"
        },
        "title": "Changes",
        "type": "array"
      },
      "Index": {
        "properties": {
          "capturedAt": {
            "type": "string"
          },
          "counts": {
            "additionalProperties": {
              "minimum": 0,
              "type": "integer"
            },
            "required": [
              "items",
              "structures",
              "skins"
            ],
            "type": "object"
          },
          "gameVersion": {
            "type": "string"
          },
          "languages": {
            "contains": {
              "const": "en"
            },
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "gameVersion",
          "capturedAt",
          "languages",
          "counts"
        ],
        "title": "Index",
        "type": "object"
      },
      "Item": {
        "properties": {
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "crop": {
            "description": "farm seeds only (null otherwise): what it grows into and how",
            "properties": {
              "grows": {
                "description": "the crop item",
                "type": [
                  "string",
                  "null"
                ]
              },
              "growthTime": {
                "description": "watered day phases to grow (a day has 5; a nearby Harvest Totem adds half a phase each)",
                "type": "number"
              },
              "harvests": {
                "description": "how many times one seed can be harvested (random in this range)",
                "properties": {
                  "max": {
                    "type": "integer"
                  },
                  "min": {
                    "type": "integer"
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "type": "object"
              },
              "season": {
                "description": "the only season it grows in, unless a Farm Crop Grower or rotstone fertiliser is used",
                "enum": [
                  "spring",
                  "winter"
                ]
              },
              "stages": {
                "description": "visible growth stages",
                "type": "integer"
              }
            },
            "required": [
              "grows",
              "growthTime",
              "stages",
              "harvests",
              "season"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "description": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "descriptionPlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "description without the game's text markup",
            "type": "object"
          },
          "icon": {
            "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "meal": {
            "description": "Meals and drinks only (null otherwise): how to make it and what it does",
            "properties": {
              "cookTime": {
                "description": "cooking time (the game's own units)",
                "type": "number"
              },
              "dlc": {
                "type": "boolean"
              },
              "effects": {
                "items": {
                  "properties": {
                    "chance": {
                      "description": "percent",
                      "type": "integer"
                    },
                    "description": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "required": [
                        "en"
                      ],
                      "type": "object"
                    },
                    "descriptionPlain": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "type": "object"
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "chance",
                    "description",
                    "descriptionPlain"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "faith": {
                "description": "faith gained when followers eat it",
                "type": "integer"
              },
              "recipes": {
                "description": "every ingredient combination the game accepts; empty for what the kitchen doesn't cook (a burned meal comes from overcooking)",
                "items": {
                  "items": {
                    "properties": {
                      "item": {
                        "type": "string"
                      },
                      "quantity": {
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "item",
                      "quantity"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              "satiation": {
                "description": "how much a follower's hunger it fills (the game's own units)",
                "type": "integer"
              },
              "satiationPlayer": {
                "description": "how much it heals the player when eaten",
                "type": "integer"
              },
              "stars": {
                "description": "quality stars the cooking menu shows",
                "type": "integer"
              },
              "tummyRating": {
                "type": "number"
              }
            },
            "required": [
              "recipes",
              "satiation",
              "satiationPlayer",
              "stars",
              "tummyRating",
              "faith",
              "cookTime",
              "dlc",
              "effects"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "required": [
              "en"
            ],
            "type": "object"
          },
          "namePlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "name without the game's text markup",
            "type": "object"
          },
          "seed": {
            "description": "crops only: the seed item that grows it (null if none, or the game doesn't name that seed)",
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "description": "food, fish, big_fish, meat, heart, gift, meal, drink",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "category",
          "namePlain",
          "descriptionPlain"
        ],
        "title": "Item",
        "type": "object"
      },
      "Skin": {
        "properties": {
          "description": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "descriptionPlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "description without the game's text markup",
            "type": "object"
          },
          "hidden": {
            "type": "boolean"
          },
          "icon": {
            "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "required": [
              "en"
            ],
            "type": "object"
          },
          "namePlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "name without the game's text markup",
            "type": "object"
          },
          "unlock": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "unlock",
          "hidden",
          "namePlain",
          "descriptionPlain"
        ],
        "title": "Skin",
        "type": "object"
      },
      "Structure": {
        "properties": {
          "buildable": {
            "description": "appears in the build menu",
            "type": "boolean"
          },
          "category": {
            "description": "the game's structure category (FOOD, FAITH, ...), null if not buildable",
            "type": [
              "string",
              "null"
            ]
          },
          "cost": {
            "items": {
              "properties": {
                "item": {
                  "type": "string"
                },
                "quantity": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "item",
                "quantity"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "description": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "descriptionPlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "description without the game's text markup",
            "type": "object"
          },
          "icon": {
            "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "menu": {
            "description": "build menu tab and section, e.g. Follower/Food, Faith/Sin, Aesthetic/Path; null if not in the build menu",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "required": [
              "en"
            ],
            "type": "object"
          },
          "namePlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "name without the game's text markup",
            "type": "object"
          },
          "size": {
            "properties": {
              "h": {
                "minimum": 1,
                "type": "integer"
              },
              "w": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "w",
              "h"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "upgradesFrom": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "cost",
          "upgradesFrom",
          "size",
          "namePlain",
          "descriptionPlain"
        ],
        "title": "Structure",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Items, structures and follower skins from *Cult of the Lamb*, taken from the game (version 1.4.6, captured 2026-10-29T12:00:00Z). Static JSON: no keys, no rate limits, open CORS. Within `v1/` fields are only added, never removed.\n\nUnofficial fan project; the game, its data and art belong to Massive Monster and Devolver Digital. Source: [github.com/AuthFailed/cotl-api](https://github.com/AuthFailed/cotl-api).",
    "title": "Cult of the Lamb data API",
    "version": "1.4.6"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/changes.json": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Changes"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "description": "No such id"
          }
        },
        "summary": "What each game version added, removed or changed, newest first",
        "tags": [
          "index"
        ]
      }
    },
    "/v1/icons/items/{id}.png": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "enum": [
                "LOG",
                "STONE"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "OK"
          },
          "404": {
            "description": "No such id"
          }
        },
        "summary": "A item's icon",
        "tags": [
          "items"
        ]
      }
    },
    "/v1/icons/structures/{id}.png": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "enum": [
                "FARM_PLOT",
                "SHRINE_II"
              ],
              "type": "string"
