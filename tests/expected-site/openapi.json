{
  "components": {
    "schemas": {
      "Changes": {
        "description": "Newest first: what each new game version added, removed or changed.",
        "items": {
          "properties": {
            "added": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": [
                "items",
                "structures",
                "skins"
              ],
              "type": "object"
            },
            "capturedAt": {
              "type": "string"
            },
            "changed": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": [
                "items",
                "structures",
                "skins"
              ],
              "type": "object"
            },
            "gameVersion": {
              "type": "string"
            },
            "removed": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": [
                "items",
                "structures",
                "skins"
              ],
              "type": "object"
            }
          },
          "required": [
            "gameVersion",
            "capturedAt",
            "added",
            "removed",
            "changed"
          ],
          "type": "object"
        },
        "title": "Changes",
        "type": "array"
      },
      "Index": {
        "properties": {
          "capturedAt": {
            "type": "string"
          },
          "counts": {
            "additionalProperties": {
              "minimum": 0,
              "type": "integer"
            },
            "required": [
              "items",
              "structures",
              "skins"
            ],
            "type": "object"
          },
          "gameVersion": {
            "type": "string"
          },
          "languages": {
            "contains": {
              "const": "en"
            },
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "gameVersion",
          "capturedAt",
          "languages",
          "counts"
        ],
        "title": "Index",
        "type": "object"
      },
      "Item": {
        "properties": {
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "crop": {
            "description": "farm seeds only (null otherwise): what it grows into and how",
            "properties": {
              "grows": {
                "description": "the crop item",
                "type": [
                  "string",
                  "null"
                ]
              },
              "growthTime": {
                "description": "watered day phases to grow (a day has 5; a nearby Harvest Totem adds half a phase each)",
                "type": "number"
              },
              "harvests": {
                "description": "how many times one seed can be harvested (random in this range)",
                "properties": {
                  "max": {
                    "type": "integer"
                  },
                  "min": {
                    "type": "integer"
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "type": "object"
              },
              "season": {
                "description": "the only season it grows in, unless a Farm Crop Grower or rotstone fertiliser is used",
                "enum": [
                  "spring",
                  "winter"
                ]
              },
              "stages": {
                "description": "visible growth stages",
                "type": "integer"
              }
            },
            "required": [
              "grows",
              "growthTime",
              "stages",
              "harvests",
              "season"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "description": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "descriptionPlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "description without the game's text markup",
            "type": "object"
          },
          "icon": {
            "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "meal": {
            "description": "Meals and drinks only (null otherwise): how to make it and what it does",
            "properties": {
              "cookTime": {
                "description": "cooking time (the game's own units)",
                "type": "number"
              },
              "dlc": {
                "type": "boolean"
              },
              "effects": {
                "items": {
                  "properties": {
                    "chance": {
                      "description": "percent",
                      "type": "integer"
                    },
                    "description": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "required": [
                        "en"
                      ],
                      "type": "object"
                    },
                    "descriptionPlain": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "type": "object"
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "chance",
                    "description",
                    "descriptionPlain"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "faith": {
                "description": "faith gained when followers eat it",
                "type": "integer"
              },
              "recipes": {
                "description": "every ingredient combination the game accepts; empty for what the kitchen doesn't cook (a burned meal comes from overcooking)",
                "items": {
                  "items": {
                    "properties": {
                      "item": {
                        "type": "string"
                      },
                      "quantity": {
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "item",
                      "quantity"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              "satiation": {
                "description": "how much a follower's hunger it fills (the game's own units)",
                "type": "integer"
              },
              "satiationPlayer": {
                "description": "how much it heals the player when eaten",
                "type": "integer"
              },
              "stars": {
                "description": "quality stars the cooking menu shows",
                "type": "integer"
              },
              "tummyRating": {
                "type": "number"
              }
            },
            "required": [
              "recipes",
              "satiation",
              "satiationPlayer",
              "stars",
              "tummyRating",
              "faith",
              "cookTime",
              "dlc",
              "effects"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "required": [
              "en"
            ],
            "type": "object"
          },
          "namePlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "name without the game's text markup",
            "type": "object"
          },
          "seed": {
            "description": "crops only: the seed item that grows it (null if none, or the game doesn't name that seed)",
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "description": "food, fish, big_fish, meat, heart, gift, meal, drink",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "usedIn": {
            "description": "where the item is used: structure costs, meal and drink recipes, ritual costs",
            "properties": {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "rituals": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "structures": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "structures",
              "items",
              "rituals"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "category",
          "namePlain",
          "descriptionPlain",
          "usedIn"
        ],
        "title": "Item",
        "type": "object"
      },
      "Ritual": {
        "properties": {
          "alternative": {
            "description": "pair rituals: the other choice of the same doctrine (the Crystal Doctrine unlocks both)",
            "type": [
              "string",
              "null"
            ]
          },
          "cost": {
            "items": {
              "properties": {
                "item": {
                  "type": "string"
                },
                "quantity": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "item",
                "quantity"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "description": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "descriptionPlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "description without the game's text markup",
            "type": "object"
          },
          "doctrine": {
            "description": "the doctrine that unlocks it",
            "type": [
              "string",
              "null"
            ]
          },
          "faith": {
            "description": "faith change when performed (base value, before cult traits)",
            "type": "number"
          },
          "group": {
            "description": "how the ritual menu lists it; pair rituals come from a doctrine choice",
            "enum": [
              "secondary",
              "pair",
              "single",
              "special"
            ]
          },
          "icon": {
            "pattern": "^icons/rituals/[A-Za-z0-9_-]+\\.png$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "required": [
              "en"
            ],
            "type": "object"
          },
          "namePlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "name without the game's text markup",
            "type": "object"
          },
          "sin": {
            "description": "sin change when performed",
            "type": "integer"
          },
          "trait": {
            "description": "cult trait performing it can give",
            "type": [
              "string",
              "null"
            ]
          },
          "warmth": {
            "description": "warmth change when performed",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "namePlain",
          "descriptionPlain",
          "icon",
          "cost",
          "faith",
          "warmth",
          "sin",
          "trait",
          "group",
          "alternative",
          "doctrine"
        ],
        "title": "Ritual",
        "type": "object"
      },
      "Skin": {
        "properties": {
          "description": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "descriptionPlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "description without the game's text markup",
            "type": "object"
          },
          "hidden": {
            "type": "boolean"
          },
          "icon": {
            "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "required": [
              "en"
            ],
            "type": "object"
          },
          "namePlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "name without the game's text markup",
            "type": "object"
          },
          "unlock": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "unlock",
          "hidden",
          "namePlain",
          "descriptionPlain"
        ],
        "title": "Skin",
        "type": "object"
      },
      "Structure": {
        "properties": {
          "buildable": {
            "description": "appears in the build menu",
            "type": "boolean"
          },
          "category": {
            "description": "the game's structure category (FOOD, FAITH, ...), null if not buildable",
            "type": [
              "string",
              "null"
            ]
          },
          "cost": {
            "items": {
              "properties": {
                "item": {
                  "type": "string"
                },
                "quantity": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "item",
                "quantity"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "description": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "descriptionPlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "description without the game's text markup",
            "type": "object"
          },
          "icon": {
            "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "menu": {
            "description": "build menu tab and section, e.g. Follower/Food, Faith/Sin, Aesthetic/Path; null if not in the build menu",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "required": [
              "en"
            ],
            "type": "object"
          },
          "namePlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "name without the game's text markup",
            "type": "object"
          },
          "size": {
            "properties": {
              "h": {
                "minimum": 1,
                "type": "integer"
              },
              "w": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "w",
              "h"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "upgradesFrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "upgradesTo": {
            "description": "structures that upgrade from this one (the reverse of upgradesFrom)",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "cost",
          "upgradesFrom",
          "size",
          "namePlain",
          "descriptionPlain",
          "upgradesTo"
        ],
        "title": "Structure",
        "type": "object"
      }
    }
