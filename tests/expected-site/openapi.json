{
  "components": {
    "schemas": {
      "Changes": {
        "description": "Newest first: what each new game version added, removed or changed.",
        "items": {
          "properties": {
            "added": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": [
                "items",
                "structures",
                "skins"
              ],
              "type": "object"
            },
            "capturedAt": {
              "type": "string"
            },
            "changed": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": [
                "items",
                "structures",
                "skins"
              ],
              "type": "object"
            },
            "gameVersion": {
              "type": "string"
            },
            "removed": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": [
                "items",
                "structures",
                "skins"
              ],
              "type": "object"
            }
          },
          "required": [
            "gameVersion",
            "capturedAt",
            "added",
            "removed",
            "changed"
          ],
          "type": "object"
        },
        "title": "Changes",
        "type": "array"
      },
      "Index": {
        "properties": {
          "capturedAt": {
            "type": "string"
          },
          "counts": {
            "additionalProperties": {
              "minimum": 0,
              "type": "integer"
            },
            "required": [
              "items",
              "structures",
              "skins"
            ],
            "type": "object"
          },
          "gameVersion": {
            "type": "string"
          },
          "languages": {
            "contains": {
              "const": "en"
            },
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "gameVersion",
          "capturedAt",
          "languages",
          "counts"
        ],
        "title": "Index",
        "type": "object"
      },
      "Item": {
        "properties": {
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "descriptionPlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "description without the game's text markup",
            "type": "object"
          },
          "icon": {
            "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "required": [
              "en"
            ],
            "type": "object"
          },
          "namePlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "name without the game's text markup",
            "type": "object"
          },
          "tags": {
            "description": "food, fish, big_fish, meat, heart, gift",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "category",
          "namePlain",
          "descriptionPlain"
        ],
        "title": "Item",
        "type": "object"
      },
      "Skin": {
        "properties": {
          "description": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "descriptionPlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "description without the game's text markup",
            "type": "object"
          },
          "hidden": {
            "type": "boolean"
          },
          "icon": {
            "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "required": [
              "en"
            ],
            "type": "object"
          },
          "namePlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "name without the game's text markup",
            "type": "object"
          },
          "unlock": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "unlock",
          "hidden",
          "namePlain",
          "descriptionPlain"
        ],
        "title": "Skin",
        "type": "object"
      },
      "Structure": {
        "properties": {
          "buildable": {
            "description": "appears in the build menu",
            "type": "boolean"
          },
          "category": {
            "description": "the game's structure category (FOOD, FAITH, ...), null if not buildable",
            "type": [
              "string",
              "null"
            ]
          },
          "cost": {
            "items": {
              "properties": {
                "item": {
                  "type": "string"
                },
                "quantity": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "item",
                "quantity"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "description": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "descriptionPlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "description without the game's text markup",
            "type": "object"
          },
          "icon": {
            "pattern": "^icons/(items|structures|skins)/[A-Za-z0-9_-]+\\.png$",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "menu": {
            "description": "build menu tab and section, e.g. Follower/Food, Faith/Sin, Aesthetic/Path; null if not in the build menu",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "required": [
              "en"
            ],
            "type": "object"
          },
          "namePlain": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "name without the game's text markup",
            "type": "object"
          },
          "size": {
            "properties": {
              "h": {
                "minimum": 1,
                "type": "integer"
              },
              "w": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "w",
              "h"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "upgradesFrom": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "cost",
          "upgradesFrom",
          "size",
          "namePlain",
          "descriptionPlain"
        ],
        "title": "Structure",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Items, structures and follower skins from *Cult of the Lamb*, taken from the game (version 1.4.6, captured 2026-10-29T12:00:00Z). Static JSON: no keys, no rate limits, open CORS. Within `v1/` fields are only added, never removed.\n\nUnofficial fan project; the game, its data and art belong to Massive Monster and Devolver Digital. Source: [github.com/AuthFailed/cotl-api](https://github.com/AuthFailed/cotl-api).",
    "title": "Cult of the Lamb data API",
    "version": "1.4.6"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/changes.json": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Changes"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "description": "No such id"
          }
        },
        "summary": "What each game version added, removed or changed, newest first",
        "tags": [
          "index"
        ]
      }
    },
    "/v1/icons/items/{id}.png": {
      "get": {
        "parameters": [
